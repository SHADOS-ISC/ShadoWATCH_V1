# Copy to /etc/shadowatch.env (chmod 600) and fill in. NEVER commit the real file.

# MISP (use a dedicated READ-ONLY user)
MISP_URL=https://misp.example.org
MISP_KEY=replace-with-readonly-api-key
# 1 (default) verifies the TLS certificate. Set to 0 ONLY for a lab with a self-signed certificate.
MISP_VERIFY_TLS=1

# OpenCTI (optional; enables the Vulnerabilities and Intel reports tabs)
OPENCTI_URL=http://opencti.example.org:8080
OPENCTI_TOKEN=replace-with-readonly-token
# 1 (default) verifies the OpenCTI certificate. 0 only for a lab.
OPENCTI_VERIFY_TLS=1

# Optional: GeoIP city database (.mmdb) for the source-country map and top countries
# GEOIP_DB=/opt/GeoLite2-City.mmdb

# Optional: where OpenCTI data is written (same folder as the generated page)
# CTI_OUT=/var/www/html/shadowatch/cti.json
